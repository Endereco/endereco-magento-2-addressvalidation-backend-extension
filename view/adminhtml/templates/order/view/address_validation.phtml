<?php
/** @var AddressValidation $block */
/** @var Escaper $escaper */

use Magento\Framework\Escaper;
use Parc\AddressValidation\Block\Adminhtml\AddressValidation;

$addressValidation = $block->getValidatedAddress();

if ($addressValidation !== null) {
    $addressValidationId = $addressValidation->getAddressValidationId();
    $orderId = $addressValidation->getOrderId();
    $houseNumber = $addressValidation->getResolvedHouseNumber();
    // getResolvedStreet() has no orig_* fallback of its own (orig_street_full is
    // one already-combined string, not a separate street/house-number pair - see
    // StreetLineBuilder::buildFromResolved()). Falling back to it here directly,
    // for display only, avoids a blank Street field when Zip/City/Region are
    // already prefilled from orig_*; house number is left blank rather than
    // guessed out of the combined string.
    $street = $addressValidation->getResolvedStreet() ?? $addressValidation->getOrigStreetFull();
    $zipCode = $addressValidation->getResolvedZipCode();
    $city = $addressValidation->getResolvedCity();
    $additionalInfo = $addressValidation->getResolvedAdditionalInformation();
    $regionId = $addressValidation->getResolvedRegionId();
    $countryId = (string)$block->getOrder()->getShippingAddress()->getCountryId();
    $regionOptions = $block->getRegionOptions($countryId);
    ?>
    <section class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $block->escapeHtml(__('Validated Shipping Address')); ?></span>
        </div>
        <div class="admin__page-section-content">
            <form id="validated-address-form"
                  action="<?= $escaper->escapeUrl($block->getFormActionUrl()) ?>"
                  method="post">
                <input type="hidden" name="form_key" value="<?= $block->escapeHtml($block->getFormKey()) ?>">
                <strong><?= $block->escapeHtml(__('Address')); ?></strong>
                <?php if ($addressValidation->getEditedBy()): ?>
                    <span><?= $block->escapeHtml(__('edited at')); ?>
                        <?= $block->escapeHtml($addressValidation->getEditedAt()) ?>
                        <?= $block->escapeHtml(__('by')); ?>
                        <?= $block->escapeHtml($addressValidation->getEditedBy()) ?>
                    </span>
                <?php endif; ?>
                <p style="padding-top:10px;">
                    <label for="houseNumber"
                           class="address-label"><?= $block->escapeHtml(__('House Number')); ?></label>
                    <input type="text" id="houseNumber" name="houseNumber" class="address-input"
                           value="<?= $block->escapeHtml($houseNumber); ?>">
                </p>
                <p>
                    <label for="street" class="address-label"><?= $block->escapeHtml(__('Street')); ?></label>
                    <input type="text" id="street" name="street" class="address-input"
                           value="<?= $block->escapeHtml($street); ?>">
                </p>
                <p>
                    <label for="zipCode" class="address-label"><?= $block->escapeHtml(__('Zip Code')); ?></label>
                    <input type="text" id="zipCode" name="zipCode" class="address-input"
                           value="<?= $block->escapeHtml($zipCode); ?>">
                </p>
                <p>
                    <label for="city" class="address-label"><?= $block->escapeHtml(__('City')); ?></label>
                    <input type="text" id="city" name="city" class="address-input"
                           value="<?= $block->escapeHtml($city); ?>">
                </p>
                <p>
                    <label for="regionId" class="address-label"><?= $block->escapeHtml(__('Region')); ?></label>
                    <select id="regionId" name="regionId" class="address-input">
                        <option value=""><?= $block->escapeHtml(__('-- Please select --')); ?></option>
                        <?php foreach ($regionOptions as $optionRegionId => $optionRegionName): ?>
                            <option value="<?= $block->escapeHtml((string)$optionRegionId); ?>"
                                <?= $optionRegionId === $regionId ? 'selected="selected"' : ''; ?>>
                                <?= $block->escapeHtml($optionRegionName); ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </p>
                <p class="textarea-container">
                    <label for="additionalInfo"
                           class="fixed-width-label"><?= $block->escapeHtml(__('Additional Info')); ?></label>
                    <textarea id="additionalInfo"
                              name="additionalInfo"
                              class="address-input"><?= $block->escapeHtml($additionalInfo); ?></textarea>
                </p>
                <br>
                <div>
                    <input type="hidden" name="addressValidationId"
                           value="<?= $block->escapeHtml($addressValidationId); ?>">
                    <input type="hidden" name="orderId"
                           value="<?= $block->escapeHtml($orderId); ?>">
                    <button type="submit" name="action" value="save"><?= $block->escapeHtml(__('Save')); ?></button>
                    <button type="submit" name="action" value="save_as_shipping"><?= $block->escapeHtml(__('Save as shipping address')); ?></button>
                    <button type="submit" name="action" value="restore_original"><?= $block->escapeHtml(__('Restore orig. shipping address')); ?></button>
                </div>
            </form>
        </div>
    </section>
<?php } ?>

<style>
    .address-label {
        width: 150px;
        display: inline-block;
    }

    .address-input {
        width:300px;
    }

     .fixed-width-label {
         width: 150px;
         display: inline-block;
         vertical-align: middle;
     }

    .textarea-container {
        display: inline-flex;
        align-items: center;
    }
</style>
