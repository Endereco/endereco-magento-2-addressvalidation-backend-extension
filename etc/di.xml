<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<preference for="Parc\AddressValidation\Api\AddressValidationRepositoryInterface" type="Parc\AddressValidation\Model\AddressValidationRepository"/>
	<preference for="Parc\AddressValidation\Api\Data\AddressValidationInterface" type="Parc\AddressValidation\Model\AddressValidation"/>
	<preference for="Parc\AddressValidation\Api\Data\AddressValidationSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>

  <type name="Magento\Sales\Block\Adminhtml\Order\View\Info">
    <plugin name="address_validation" type="Parc\AddressValidation\Block\Adminhtml\AddressValidation" sortOrder="10" />
  </type>

  <type name="Magento\Cron\Model\Config">
    <plugin name="disable_parc_cron_plugin" type="Parc\AddressValidation\Plugin\CronConfigPlugin" />
  </type>

  <type name="Magento\Sales\Api\OrderManagementInterface">
    <plugin name="add_code_on_unhold" type="Parc\AddressValidation\Plugin\OrderUnholdPlugin"/>
  </type>
</config>
