includes:
    - ./phpstan-baseline.neon
    - vendor/bitexpert/phpstan-magento/extension.neon

parameters:
    level: 8
    paths:
        - .
    excludePaths:
        - vendor
        - node_modules (?)
        - dev (?)
        - Test (?)
        - review (?)
        - shops
        - registration.php
    bootstrapFiles:
        - shops/2.4.6/vendor/autoload.php
    magento:
        magentoRoot: shops/2.4.6
    phpVersion: 80200
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
