{
    "name": "endereco/magento2-address-validation-backend-phpstan",
    "description": "PHPStan dependencies for endereco/magento2-address-validation-backend",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "magento/magento-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "laminas/laminas-dependency-plugin": false
        }
    },
    "require": {
        "php": "^8.1",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.40"
    },
    "autoload": {
        "psr-4": {
            "Parc\\AddressValidation\\": ""
        }
    }
}
