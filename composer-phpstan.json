{
    "name": "parc/module-addressvalidation-phpstan",
    "description": "PHPStan dependencies for parc/module-addressvalidation",
    "type": "project",
    "license": "GPL-3.0",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "magento/magento-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "laminas/laminas-dependency-plugin": false
        }
    },
    "require": {
        "php": "^8.1",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.40"
    },
    "autoload": {
        "psr-4": {
            "Parc\\AddressValidation\\": ""
        }
    }
}
